# ==============================================================================
# RoadSense Cloud Backend Configuration
# ==============================================================================

# Application Environment (development | production)
FLASK_ENV=development
PORT=6969
SECRET_KEY=roadsense_super_secret_jwt_key_2026

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///app.db
# Amazon RDS PostgreSQL (Used on AWS EC2):
# DATABASE_URL=postgresql://roadsense_admin:<password>@roadsense-db.cxxxxxx.us-east-1.rds.amazonaws.com:5432/roadsensedb

# ==============================================================================
# AWS Cloud Services Configuration (Optional for local test; auto-loaded via SSM on EC2)
# ==============================================================================
RUNNING_IN_AWS=false
AWS_REGION=us-east-1

# Amazon S3 Bucket for Road Hazard Images
S3_BUCKET=roadsense-hazards-media-bucket

# Amazon SNS Topic ARN for Critical Hazard Alerts
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:roadsense-critical-alerts

# Amazon SQS Queue URL for Async Processing & Deduplication
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/roadsense-hazard-queue
